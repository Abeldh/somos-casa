generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum NotificationType {
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  PAYMENT_VERIFIED
  SESSIONS_RELEASED
  NEW_BOOK
  REFERRAL_BONUS
  COUPON_RECEIVED
  GENERAL
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponAppliesTo {
  BOOKS
  SESSIONS
  ALL
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum PaymentType {
  SESSION_PACKAGE
  BOOK_ORDER
  OTHER
}

enum PaymentMethod {
  PAYPAL
  TRANSFER
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MediaType {
  SPOTIFY
  YOUTUBE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  role         Role     @default(CLIENT)
  isActive     Boolean  @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at")
  sessionsRemaining Int  @default(0) @map("sessions_remaining")
  sessionsTotal     Int  @default(0) @map("sessions_total")
  sessionsPaidAt    DateTime? @map("sessions_paid_at")
  paymentProofUrl   String?   @map("payment_proof_url")
  referralCode      String?   @unique @map("referral_code")
  referredBy        String?   @map("referred_by")
  preferredLang     String    @default("es") @map("preferred_lang")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  cartItems    CartItem[]
  orders       Order[]
  refreshTokens RefreshToken[]
  mfaSecret    MfaSecret?
  testimonials Testimonial[]
  passwordResetTokens PasswordResetToken[]
  notifications      Notification[]
  sessionNotes       SessionNote[]
  referralsMade      Referral[] @relation("referrer")
  referralsReceived  Referral[] @relation("referred")
  payments           Payment[]

  @@map("users")
}

model Appointment {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  date           DateTime
  startTime      String            @map("start_time")
  endTime        String            @map("end_time")
  status         AppointmentStatus @default(PENDING)
  partnerName    String            @map("partner_name")
  reason         String
  notes          String?
  zoomUrl        String?  @map("zoom_url")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionNotes   SessionNote[]

  @@index([userId, status])
  @@index([date])
  @@index([status])
  @@map("appointments")
}

model Availability {
  id        String   @id @default(uuid())
  date      DateTime
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  isBooked  Boolean  @default(false) @map("is_booked")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([date, isBooked])
  @@index([date])
  @@map("availability")
}

model Media {
  id          String    @id @default(uuid())
  type        MediaType
  title       String
  url         String
  description String?
  thumbnail   String?
  category    String?
  isActive    Boolean   @default(true) @map("is_active")
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("media")
}

model Book {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  author      String
  description String?
  price       Float
  coverImage  String?  @map("cover_image")
  pdfUrl      String?  @map("pdf_url")
  category    String?
  isbn        String?
  stock       Int      @default(0)
  pages       Int?
  publisher   String?
  language    String   @default("Español")
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([isActive])
  @@index([category])
  @@map("books")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  orderNumber     String      @unique @map("order_number")
  status          OrderStatus @default(PENDING)
  subtotal        Float
  shippingCost    Float       @default(0) @map("shipping_cost")
  discount        Float       @default(0)
  total           Float
  couponId        String?     @map("coupon_id")
  couponCode      String?     @map("coupon_code")
  shippingName    String?     @map("shipping_name")
  shippingPhone   String?     @map("shipping_phone")
  shippingAddress String?     @map("shipping_address")
  shippingCity    String?     @map("shipping_city")
  shippingState   String?     @map("shipping_state")
  shippingZip     String?     @map("shipping_zip")
  notes           String?
  paymentProofUrl String?   @map("payment_proof_url")
  paidAt          DateTime?   @map("paid_at")
  shippedAt       DateTime?   @map("shipped_at")
  deliveredAt     DateTime?   @map("delivered_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon          Coupon?     @relation(fields: [couponId], references: [id])
  items           OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String @map("order_id")
  bookId   String @map("book_id")
  title    String
  price    Float
  quantity Int

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  token       String   @unique
  family      String
  isRevoked   Boolean  @default(false) @map("is_revoked")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  replacedBy  String?  @map("replaced_by")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model MfaSecret {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  secret      String
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  event      String
  detail     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  deviceType String?  @map("device_type")
  browser    String?
  os         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logs")
}

model Testimonial {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  text       String
  rating     Int      @default(5)
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("testimonials")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Payment {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  type          PaymentType
  method        PaymentMethod @default(TRANSFER)
  status        PaymentStatus @default(PENDING)
  amount        Float
  currency      String        @default("MXN")
  reference     String?
  orderId       String?       @map("order_id")
  proofUrl      String?       @map("proof_url")
  verifiedBy    String?       @map("verified_by")
  verifiedAt    DateTime?     @map("verified_at")
  rejectedAt    DateTime?     @map("rejected_at")
  rejectionNote String?       @map("rejection_note")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("payments")
}


model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  link      String?
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Coupon {
  id            String        @id @default(uuid())
  code          String        @unique
  type          CouponType
  value         Float
  appliesTo     CouponAppliesTo @default(ALL) @map("applies_to")
  minPurchase   Float?        @map("min_purchase")
  maxDiscount   Float?        @map("max_discount")
  maxUses       Int?          @map("max_uses")
  usedCount     Int           @default(0) @map("used_count")
  isActive      Boolean       @default(true) @map("is_active")
  startsAt      DateTime?     @map("starts_at")
  expiresAt     DateTime?     @map("expires_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  usages        CouponUsage[]
  orders        Order[]

  @@map("coupons")
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String?  @map("order_id")
  discount  Float
  createdAt DateTime @default(now()) @map("created_at")

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

model SessionNote {
  id            String   @id @default(uuid())
  appointmentId String   @map("appointment_id")
  userId        String   @map("user_id")
  content       String
  isPrivate     Boolean  @default(true) @map("is_private")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([userId])
  @@map("session_notes")
}

model Referral {
  id           String         @id @default(uuid())
  referrerId   String         @map("referrer_id")
  referredId   String?        @map("referred_id")
  referredEmail String?       @map("referred_email")
  status       ReferralStatus @default(PENDING)
  bonusGiven   Boolean        @default(false) @map("bonus_given")
  createdAt    DateTime       @default(now()) @map("created_at")
  completedAt  DateTime?      @map("completed_at")

  referrer     User           @relation("referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred     User?          @relation("referred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([referredId])
  @@map("referrals")
}
