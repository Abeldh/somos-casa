generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MediaType {
  SPOTIFY
  YOUTUBE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  role         Role     @default(CLIENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  appointments Appointment[]
  cartItems    CartItem[]
  orders       Order[]
  refreshTokens RefreshToken[]
  mfaSecret    MfaSecret?

  @@map("users")
}

model Appointment {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  date           DateTime
  startTime      String            @map("start_time")
  endTime        String            @map("end_time")
  status         AppointmentStatus @default(PENDING)
  partnerName    String            @map("partner_name")
  reason         String
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Availability {
  id        String   @id @default(uuid())
  date      DateTime
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  isBooked  Boolean  @default(false) @map("is_booked")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("availability")
}

model Media {
  id          String    @id @default(uuid())
  type        MediaType
  title       String
  url         String
  description String?
  thumbnail   String?
  category    String?
  isActive    Boolean   @default(true) @map("is_active")
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("media")
}

model Book {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  author      String
  description String?
  price       Float
  coverImage  String?  @map("cover_image")
  category    String?
  isbn        String?  @unique
  stock       Int      @default(0)
  pages       Int?
  publisher   String?
  language    String   @default("Español")
  isActive    Boolean  @default(true) @map("is_active")
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@map("books")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  bookId    String   @map("book_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  orderNumber     String      @unique @map("order_number")
  status          OrderStatus @default(PENDING)
  subtotal        Float
  shippingCost    Float       @default(0) @map("shipping_cost")
  total           Float
  shippingName    String?     @map("shipping_name")
  shippingPhone   String?     @map("shipping_phone")
  shippingAddress String?     @map("shipping_address")
  shippingCity    String?     @map("shipping_city")
  shippingState   String?     @map("shipping_state")
  shippingZip     String?     @map("shipping_zip")
  notes           String?
  paidAt          DateTime?   @map("paid_at")
  shippedAt       DateTime?   @map("shipped_at")
  deliveredAt     DateTime?   @map("delivered_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@map("orders")
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String @map("order_id")
  bookId   String @map("book_id")
  title    String
  price    Float
  quantity Int

  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  token       String   @unique
  family      String
  isRevoked   Boolean  @default(false) @map("is_revoked")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  replacedBy  String?  @map("replaced_by")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model MfaSecret {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  secret      String
  isVerified  Boolean  @default(false) @map("is_verified")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  event      String
  detail     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logs")
}
